          "workItemId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "notResolved": {
            "type": "boolean"
          },
          "missingReleaseNote": {
            "type": "boolean"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ReleaseValidationSummary": {
        "type": "object",
        "properties": {
          "totalWorkItemCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "resolvedWorkItemCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "releaseNotActive": {
            "type": "boolean"
          },
          "hasNoWorkItems": {
            "type": "boolean"
          },
          "failedWorkItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FailedWorkItem"
            }
          },
          "isValid": {
            "type": "boolean"
          }
        }
      },
      "WorkItemResolutionValidationSummary": {
        "required": [
          "title"
        ],
        "type": "object",
        "properties": {
          "workItemId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "releaseNote": {
            "type": [
              "null",
              "string"
            ]
          },
          "validationErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isValid": {
            "type": "boolean"
          }
        }
      },
      "WorkItemResolutionValidationSummarySet": {
        "type": "object",
        "properties": {
          "workItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkItemResolutionValidationSummary"
            }
          },
          "targetStatusError": {
            "type": [
              "null",
              "string"
            ]
          },
          "isValid": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
